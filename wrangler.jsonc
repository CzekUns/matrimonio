{
  // Sostituire l'ID dopo: npx wrangler d1 create matrimonio-db
  "name": "matrimonio-social",
  "main": "./worker/src/index.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "matrimonio-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
